
# ==============================
# SHARED (all services)
# ==============================
DATABASE_URL=jdbc:postgresql://localhost:5432/r1superapp
DATABASE_URL_NODE=postgresql://r1user:r1password@localhost:5432/r1superapp
REDIS_URL=redis://:r1redispass@localhost:6379
JWT_SECRET=your-256-bit-hex-secret-here-change-this-in-production
INTERNAL_EVENTS_SECRET=your-internal-secret-here

# ==============================
# KAFKA (local Docker)
# ==============================
KAFKA_BROKERS=localhost:9092
# For Confluent Cloud (production):
# KAFKA_BROKERS=xxx.confluent.cloud:9092
# KAFKA_API_KEY=xxx
# KAFKA_API_SECRET=xxx

# ==============================
# DATABASE (local PostgreSQL)
# ==============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=r1superapp
POSTGRES_USER=r1user
POSTGRES_PASSWORD=r1password

# ==============================
# AUTH SERVICE
# ==============================
OTP_DEV_MODE=true
DEV_OTP=123456
FAST2SMS_API_KEY=your-fast2sms-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================
# PAYMENT SERVICE
# ==============================
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET=your-cashfree-secret
CASHFREE_ENV=TEST

# ==============================
# NOTIFICATION SERVICE
# ==============================
FIREBASE_SERVICE_ACCOUNT=base64-encoded-firebase-service-account-json

# ==============================
# STATION DASHBOARD
# ==============================
CRIS_API_KEY=your-cris-api-key-here
CRIS_API_BASE_URL=https://api.cris.org.in/v1
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET_NAME=r1-media

# ==============================
# AI SERVICES
# ==============================
OPENAI_API_KEY=sk-your-openai-key-here
HUGGINGFACE_API_KEY=hf_your-huggingface-key-here

# ==============================
# TRAIN SERVICE
# ==============================
NTES_API_KEY=your-ntes-api-key
NTES_API_BASE_URL=https://api.railwayapi.site

# ==============================
# MAPS
# ==============================
MAPBOX_TOKEN=pk.your-mapbox-token-here

# ==============================
# SERVICE PORTS
# ==============================
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8090
AI_PLANNER_PORT=8087
AI_ASSISTANT_PORT=8088
PORTER_SERVICE_PORT=8092
NOTIFICATION_SERVICE_PORT=8093
STATION_DASHBOARD_PORT=8094
USER_SERVICE_PORT=3001
SOS_SERVICE_PORT=3006
MAP_SERVICE_PORT=3010
TRAIN_SERVICE_PORT=3011
